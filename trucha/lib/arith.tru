
data ⟂ : Type where {}

⟂-elim : ⟂ → {A : Type} → A
⟂-elim = ?

¬ : Type → Type
¬ A = A → ⟂

----

infixl 20 _,_

data Prod (A B : Type) : Type where
  _,_ : A → B → Prod A B

π₁ : {A B : Type} → Prod A B → A
π₁ (a , _) = a

π₂ : {A B : Type} → Prod A B → B
π₂ (_ , b) = b

----

infix  30 _≡_
infixr 20 _≡⟨_⟩_
infixr 30 _∎

data _≡_ {A : Type} : (a b : A) → Type where
  refl : {a : A} → _≡_ {A} a a

sym : {A : Type} {a1 a2 : A} → a1 ≡ a2 → a2 ≡ a1
sym refl = refl

trans : {A : Type} {a1 a2 a3 : A} → a1 ≡ a2 → a2 ≡ a3 → a1 ≡ a3
trans refl refl = refl

cong : {A B : Type} → (f : A → B) → {a1 a2 : A} → a1 ≡ a2 → f a1 ≡ f a2
cong _ refl = refl

_≡⟨_⟩_ : {A : Type} (a1 : A) {a2 : A} → a1 ≡ a2 → {a3 : A} → a2 ≡ a3 → a1 ≡ a3
_ ≡⟨ refl ⟩ refl = refl

_∎ : {A : Type} (a : A) → a ≡ a
_ ∎ = refl

----

infix 20 if_then_else_

data Bool : Type where
  true  : Bool
  false : Bool

if_then_else_ : Bool → {A : Type} → A → A → A
if true  then x else _ = x
if false then _ else x = x

----

data Dec (A : Type) : Type where
  yes : A → Dec A
  no  : ¬ A → Dec A

----

infixl 40 _+_
infixl 50 _*_

data ℕ : Type where
  zero : ℕ
  suc  : ℕ → ℕ

_+_ : ℕ → ℕ → ℕ
zero  + m = m
suc n + m = suc (n + m)

+-assoc : ∀ {n m p} → n + (m + p) ≡ (n + m) + p
+-assoc {zero}          = refl
+-assoc {suc n} {m} {p} = cong suc (+-assoc {n} {m} {p})

+-neut-r : ∀ {n} → n + zero ≡ n
+-neut-r {zero}  = refl
+-neut-r {suc n} = cong suc +-neut-r

+-suc-r : ∀ {n m} → n + suc m ≡ suc (n + m)
+-suc-r {zero}      = refl
+-suc-r {suc n} {m} = cong suc (+-suc-r {n} {m})

+-comm : ∀ {n m} → n + m ≡ m + n
+-comm {zero}      = sym +-neut-r
+-comm {suc n} {m} =
    suc n + m
  ≡⟨ refl ⟩
    suc (n + m)
  ≡⟨ cong suc (+-comm {n} {m}) ⟩
    suc (m + n)
  ≡⟨ sym (+-suc-r {m} {n}) ⟩
    m + suc n
  ∎

----

_*_ : ℕ → ℕ → ℕ
zero  * m = zero
suc n * m = m + n * m

*-zero-r : ∀ {n} → n * zero ≡ zero
*-zero-r {zero}  = refl
*-zero-r {suc n} = *-zero-r {n}

*-suc-r : ∀ {n m} → n * suc m ≡ n + n * m
*-suc-r {zero}      = refl
*-suc-r {suc n} {m} =
    suc n * suc m
  ≡⟨ refl ⟩
    suc m + n * suc m
  ≡⟨ refl ⟩
    suc (m + n * suc m)
  ≡⟨ cong (λ z → suc (m + z)) (*-suc-r {n} {m}) ⟩
    suc (m + (n + n * m))
  ≡⟨ cong suc (+-assoc {m} {n} {n * m}) ⟩
    suc ((m + n) + n * m)
  ≡⟨ cong (λ z → suc (z + n * m)) (+-comm {m} {n}) ⟩
    suc ((n + m) + n * m)
  ≡⟨ cong suc (sym (+-assoc {n} {m} {n * m})) ⟩
    suc (n + (m + n * m))
  ≡⟨ refl ⟩
    suc (n + suc n * m)
  ≡⟨ refl ⟩
    suc n + suc n * m
  ∎

*-comm : ∀ {n m} → n * m ≡ m * n
*-comm {zero}  {m} = sym (*-zero-r {m})
*-comm {suc n} {m} =
    suc n * m
  ≡⟨ refl ⟩
    m + n * m
  ≡⟨ cong (λ z → m + z) (*-comm {n} {m}) ⟩
    m + m * n
  ≡⟨ sym (*-suc-r {m} {n}) ⟩
    m * suc n
  ∎

*-distr-+-l : ∀ {n m p} → n * (m + p) ≡ n * m + n * p
*-distr-+-l {zero}  {m} {p} = refl
*-distr-+-l {suc n} {m} {p} =
    suc n * (m + p)
  ≡⟨ refl ⟩
    (m + p) + (n * (m + p))
  ≡⟨ cong (_+_ (m + p)) (*-distr-+-l {n} {m} {p}) ⟩
    (m + p) + (n * m + n * p)
  ≡⟨ +-assoc {m + p} {n * m} {n * p} ⟩
    ((m + p) + n * m) + n * p
  ≡⟨ cong (λ z → z + n * p) (sym (+-assoc {m} {p} {n * m})) ⟩
    (m + (p + n * m)) + n * p
  ≡⟨ cong (λ z → (m + z) + n * p) (+-comm {p} {n * m}) ⟩
    (m + (n * m + p)) + n * p
  ≡⟨ cong (λ z → z + n * p) (+-assoc {m} {n * m} {p}) ⟩
    ((m + n * m) + p) + n * p
  ≡⟨ sym (+-assoc {m + n * m} {p} {n * p}) ⟩
    (m + n * m) + (p + n * p)
  ≡⟨ refl ⟩
    suc n * m + suc n * p
  ∎

*-distr-+-r : ∀ {n m p} → (n + m) * p ≡ n * p + m * p
*-distr-+-r {n} {m} {p} =
    (n + m) * p
  ≡⟨ *-comm {n + m} {p} ⟩
    p * (n + m)
  ≡⟨ *-distr-+-l {p} {n} {m} ⟩
    p * n + p * m
  ≡⟨ cong (λ z → p * n + z) (*-comm {p} {m}) ⟩
    p * n + m * p
  ≡⟨ cong (λ z → z + m * p) (*-comm {p} {n}) ⟩
    n * p + m * p
  ∎

*-assoc : ∀ {n m p} → n * (m * p) ≡ (n * m) * p
*-assoc {zero}  {m} {p} = refl
*-assoc {suc n} {m} {p} =
    suc n * (m * p)
  ≡⟨ refl ⟩
    m * p + n * (m * p)
  ≡⟨ cong (_+_ (m * p)) (*-assoc {n} {m} {p}) ⟩
    m * p + (n * m) * p
  ≡⟨ sym (*-distr-+-r {m} {n * m} {p}) ⟩
    (m + n * m) * p
  ≡⟨ refl ⟩
    (suc n * m) * p
  ∎

----

_∸_ : ℕ → ℕ → ℕ
zero  ∸ _     = zero
suc n ∸ zero  = suc n
suc n ∸ suc m = n ∸ m

data _<_ : ℕ → ℕ → Type where
  Z<S : ∀ {n} → zero  < suc n
  S<S : ∀ {n m} → n < m → suc n < suc m

_<?_ : (n m : ℕ) → Dec (n < m)
zero  <? zero  = no (λ z<z → ?)
zero  <? suc _ = yes Z<S
suc _ <? zero  = no (λ s<z → ?)
suc n <? suc m = ?

